# Copy this file to .env in this folder (hw5/) and fill in your own Portkey key.
# Never commit the real .env: it is in .gitignore.

# Required: your Portkey API key. Every agent reaches its model through Portkey.
PORTKEY_API_KEY=your-portkey-api-key-here

# The model is NOT configurable: every agent uses gpt-6-luna (set in backend/config.py).
